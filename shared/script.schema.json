{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tutor Script",
  "type": "object",
  "required": ["topic", "steps"],
  "properties": {
    "topic": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "region": { "enum": ["left", "right", "top", "bottom"] },
    "step": {
      "type": "object",
      "required": ["say", "actions"],
      "properties": {
        "say": { "type": "string", "minLength": 1 },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["draw_line", "draw_shape", "write_text", "write_formula", "label", "highlight", "arrow", "erase", "draw_svg", "array", "flowchart", "linked_list", "binary_tree", "call_stack", "plot"]
        },
        "id": { "type": "string" },
        "shape": { "enum": ["triangle", "rect", "circle", "polygon"] },
        "points": { "type": "array", "items": { "$ref": "#/definitions/point" } },
        "from": { "$ref": "#/definitions/point" },
        "to": { "$ref": "#/definitions/point" },
        "at": { "$ref": "#/definitions/point" },
        "region": { "$ref": "#/definitions/region" },
        "target": { "type": "string" },
        "part": { "enum": ["hypotenuse", "outline"] },
        "color": { "type": "string" },
        "text": { "type": "string" },
        "latex": { "type": "string" },
        "svg": { "type": "string" },
        "values": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "anyOf": [{ "type": "string" }, { "type": "number" }] } },
        "fn": { "type": "string", "maxLength": 100 },
        "xRange": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "yRange": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "source": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
